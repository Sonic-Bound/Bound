# The BOUND block explorer as a system service, next to boundd.service (which must run with
# --index for transaction and address pages). Install as boundd.service says, then:
#   sudo install -m 644 contrib/systemd/bound-explorer.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bound-explorer
#
# It serves plain HTTP on 127.0.0.1:8080. Put a TLS-terminating proxy in front for the public,
# for example Caddy, which fetches a certificate by itself. /etc/caddy/Caddyfile:
#   explorer.example.org {
#       reverse_proxy 127.0.0.1:8080
#   }
# (To serve it directly instead, without TLS, add --public and open the port.)
[Unit]
Description=BOUND block explorer
After=boundd.service
Wants=boundd.service

[Service]
Type=simple
User=bound
Group=bound
ExecStart=/usr/local/bin/bound-explorer --datadir /var/lib/bound/testnet --port 8080 --quiet
Restart=on-failure
RestartSec=5

# It only reads the node's cookie and talks to 127.0.0.1.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/bound
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
